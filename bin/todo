#!/usr/bin/env bash
set -euo pipefail

VERSION=1.0.1
VERDATE="August 06, 2026"

todoDir="$HOME/.config/todo"
todoLocation="${todoDir}/todo.txt"

FORMAT="\033["
ESC="m"

NC="${FORMAT}0$ESC"
BOLD="${FORMAT}1${ESC}"
RED="${FORMAT}0;31$ESC"
YELLOW="${FORMAT}0;33$ESC"
GREEN="${FORMAT}0;32$ESC"
BLUE="${FORMAT}0;34$ESC"
MAGENTA="${FORMAT}0;35$ESC"

WARN="${YELLOW}[WARN]${NC}"
ERROR="${RED}[ERROR]${NC}"
INFO="${BLUE}[INFO]${NC}"
PROMPT="${MAGENTA}[PROMPT]${NC}"

usage() {
    printf "%b\n" "
${BOLD}todo${NC} [-l]
    a personal todo list tool

${BOLD}usage${NC}
    --help      -h          print help
    --version   -v          print version
    --add       -a  <item>  add to todo list
    --delete    -d  <index> remove from todo list
    --list      -l          list all of todo
"
}

ver() {
    printf "%b\n" "
todo ${BOLD}${VER}${NC} ${VERDATE}
"
}

error() {
    local msg=$1
    local exitCode=${2:-1}
    printf "%b\n" "${ERROR} ${msg}; exiting code $exitCode" &>2
    exit $exitCode
}

# make file
if [[ ! -d "$todoDir" ]]; then mkdir -p "$todoDir"; fi
if [[ ! -e "$todoLocation" ]]; then touch "$todoLocation"; fi

addTodoItem() {
    for item in "${add[@]}"; do
        echo "$item" >> "$todoLocation"
    done
}

delTodoItemIndex() {
    for index in "${del[@]}"; do
        sed -i "${index}d" "$todoLocation"
    done
}

# cat "$todoLocation"

while (($#)); do
    case "$1" in
        -h|--help)
            usage;;
        -v|--version)
            ver;;
        -a|--add)
            add=()
            shift
            while (($#)) && [[ $1 != -* ]]; do add+=("$1")
            shift; done;
            addTodoItem
            continue;;
        -d|--delete)
            del=()
            shift
            while (($#)) && [[ $1 != -* ]] && [[ $1 =~ ^[1-9][0-9]*$ ]]; do del+=("$1")
            shift; done;
            delTodoItemIndex
            continue;;
        -l|--list|*)
            i=1
            while IFS= read -r line; do
                printf "%b%2d.%b %s\n" "$BOLD" "$i" "$NC" "$line"
                ((i++))
            done < "$todoLocation"
            ;;
        -*)
            error "unknown parameter $1";;
    esac
    shift
done
