#!/usr/bin/env bash
set -euo pipefail

VERSION=1.2
VERDATE="August 24, 2026"

todoDir="$HOME/folders/text"
todoLocation="${todoDir}/todo.txt"

FORMAT="\033["
ESC="m"

NC="${FORMAT}0$ESC"
BOLD="${FORMAT}1${ESC}"
RED="${FORMAT}0;31$ESC"
ERROR="${RED}[ERROR]${NC}"

usage() {
    printf "%b\n" "
${BOLD}todo${NC} [-l]
    a personal todo list tool

${BOLD}usage${NC}
    --help      -h                      print help
    --version   -v                      print version
    --add       -a  <item>              add to todo list
    --delete    -d  <index>             remove from todo list
    --edit      -e  <index> <newitem>   edit existing item
    --list      -l                      list all of todo
    --reset     -r                      clear todo
"
}

ver() {
    printf "%b\n" "
todo ${BOLD}${VERSION}${NC} ${VERDATE}
"
}

error() {
    local msg=$1
    local exitCode=${2:-1}
    printf "%b\n" "${ERROR} ${msg}; exiting code $exitCode" >&2
    exit "$exitCode"
}

# make file
if [[ ! -d "$todoDir" ]]; then mkdir -p "$todoDir"; fi
if [[ ! -e "$todoLocation" ]]; then touch "$todoLocation"; fi

addTodoItem() {
    for item in "${add[@]}"; do
        echo "$item" >> "$todoLocation"
    done
}

delTodoItemIndex() {
    for index in $(printf '%s\n' "${del[@]}" | sort -nr); do
        sed -i "${index}d" "$todoLocation"
    done
}

while (($#)); do
    case "$1" in
        -h|--help)
            usage;;
        -v|--version)
            ver;;
        -a|--add)
            add=()
            shift
            while (($#)) && [[ $1 != -* ]]; do add+=("$1")
            shift; done;
            # echo "${add[@]}"
            addTodoItem
            continue;;
        -d|--delete)
            del=()
            shift
            while (($#)) && [[ $1 != -* ]] && [[ $1 =~ ^[1-9][0-9]*$ ]]; do del+=("$1")
            shift; done;
            # echo "${del[@]}"
            delTodoItemIndex
            continue;;
        -l|--list)
            i=1
            while IFS= read -r line; do
                printf "%b%2d.%b %s\n" "$BOLD" "$i" "$NC" "$line"
                ((++i))
            done < "$todoLocation"
            ;;
        -e|--edit)

            shift
            index="$1"
            shift
            edititem="$1"

            sed -i "${index}c\\${edititem}" "$todoLocation"
            ;;
        -r|--reset)
            newTodo="/tmp/todo.txt"
            touch "$newTodo"
            if mv "$newTodo" "$todoLocation"; then
                echo "reset"
            fi
            ;;
        -*)
            error "unknown parameter $1";;
    esac
    shift
done
