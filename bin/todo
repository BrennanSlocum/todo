#!/usr/bin/env bash
set -euo pipefail

VERSION=1.3
VERDATE="September 16, 2026"

todoDir="$HOME/folders/text"
todoLocation="${todoDir}/todo.txt"

FORMAT="\033["
ESC="m"

NC="${FORMAT}0$ESC"
BOLD="${FORMAT}1${ESC}"
RED="${FORMAT}0;31$ESC"
ERROR="${RED}[ERROR]${NC}"

usage() {
    printf "%b\n" "
${BOLD}todo${NC} [-l]
    a personal todo list tool

${BOLD}usage${NC}
    --help      -h                      print help
    --version   -v                      print version
    --add       -a  <item>              add to todo list
    --delete    -d  <index|a-b>         remove from todo list
    --edit      -e  <index> <newitem>   edit existing item
    --reset     -r                      clear todo
    --color     -c  <color>             pair with add; main 6 colors except orange
"
}

ver() {
    printf "%b\n" "
todo ${BOLD}${VERSION}${NC} ${VERDATE}
"
}

error() {
    local msg=$1
    local exitCode=${2:-1}
    printf "%b\n" "${ERROR} ${msg}; exiting code $exitCode" >&2
    exit "$exitCode"
}

# make file
if [[ ! -d "$todoDir" ]]; then mkdir -p "$todoDir"; fi
if [[ ! -e "$todoLocation" ]]; then touch "$todoLocation"; fi

addTodoItem() {
    local color="${1:-}"
    for item in "${add[@]}"; do
        echo "$color$item" >> "$todoLocation"
    done
}

delTodoItemIndex() {
    for index in $(printf '%s\n' "${del[@]}" | sort -nr); do
        sed -i "${index}d" "$todoLocation"
    done
}

listTodoItems() {
    i=1
    while IFS= read -r line; do
        printf "%b%2d.%b %b %b\n" "$BOLD" "$i" "$NC" "$line" "$NC"
        ((++i))
    done < "$todoLocation"
}

strToColor() {
    case "$1" in
        red) echo "31";;
        green) echo "32";;
        yellow) echo "33";;
        blue) echo "34";;
        magenta|purple) echo "35";;
        cyan) echo "36";;
    esac
}

add=()
del=()

while (($#)); do
    case "$1" in
        -h|--help)
            usage;;
        -v|--version)
            ver;;
        -a|--add)
            shift
            while (($#)) && [[ $1 != -* ]]; do add+=("$1")
            shift; done;
            # echo "${add[@]}"
            # addTodoItem
            # addTodoItem will be done after parsing because of --color
            continue;;
        -d|--delete)
            shift

            if [[ $1 =~ ^([1-9][0-9]*)\-([1-9][0-9]*)$ ]]; then
                num1="${BASH_REMATCH[1]}"
                num2="${BASH_REMATCH[2]}"

                if (( num1 > num2 )); then
                    biggerNum="$num1"
                    smallerNum="$num2"
                else
                    biggerNum="$num2"
                    smallerNum="$num1"
                fi

                for ((i=smallerNum; i<=biggerNum; i++)); do
                    del+=("$i")
                    # echo "$i"
                done
                shift
            else
                while (($#)) && [[ $1 != -* ]] && [[ $1 =~ ^[1-9][0-9]*$ ]]; do
                    del+=("$1")
                    shift
                done
            fi
            delTodoItemIndex
            continue;;
        # -l|--list)
        #     listTodoItems
        #     ;;
        -e|--edit)

            shift
            index="$1"
            shift
            edititem="$1"

            sed -i "${index}c\\${edititem}" "$todoLocation"
            ;;
        -r|--reset)
            newTodo="/tmp/todo.txt"
            touch "$newTodo"
            if mv "$newTodo" "$todoLocation"; then
                echo "todo reset"
            fi
            ;;
        -c|--color)
            shift
            color="\033[0;$(strToColor "$1")m"
            ;;
        -*)
            error "unknown parameter $1";;
    esac
    shift
done

if (( ${#add[@]} > 0 )); then
    addTodoItem "$color"
fi

listTodoItems
