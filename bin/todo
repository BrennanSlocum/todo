#!/usr/bin/env bash
set -euo pipefail

VERSION=1.3_1
VERDATE="October 06, 2026"

todoDir="$HOME/folders/text"
todoLocation="${todoDir}/todo.txt"

FORMAT="\033["
ESC="m"

NC="${FORMAT}0$ESC"
BOLD="${FORMAT}1${ESC}"
RED="${FORMAT}0;31$ESC"
ERROR="${RED}[ERROR]${NC}"

usage() {
    printf "%b\n" "
${BOLD}todo${NC} [-l]
    a personal todo list tool

${BOLD}usage${NC}
    --help      -h                      print help
    --version   -v                      print version
    --add       -a  <item>              add to todo list
    --delete    -d  <index|a-b>         remove from todo list
    --edit      -e  <index> <newitem>   edit existing item
    --reset     -r                      clear todo
    --color     -c  <color>             pair with add; main 6 colors except orange
"
}

ver() {
    printf "%b\n" "
todo ${BOLD}${VERSION}${NC} ${VERDATE}
"
}

error() {
    local msg=$1
    local exitCode=${2:-1}
    printf "%b\n" "${ERROR} ${msg}; exiting code $exitCode" >&2
    exit "$exitCode"
}

# make file
if [[ ! -d "$todoDir" ]]; then mkdir -p "$todoDir"; fi
if [[ ! -e "$todoLocation" ]]; then touch "$todoLocation"; fi

addTodoItem() {
    local color="${1:-}"
    for item in "${add[@]}"; do
        echo "$color$item" >> "$todoLocation"
    done
}

delTodoItemIndex() {
    for index in $(printf '%s\n' "${del[@]}" | sort -nr); do
        sed -i "${index}d" "$todoLocation"
    done
}

listTodoItems() {
    i=1
    while IFS= read -r line; do
        printf "%b%2d.%b %b %b\n" "$BOLD" "$i" "$NC" "$line" "$NC"
        ((++i))
    done < "$todoLocation"
}

editTodoItem() {
    local index=$1
    local newItem=$2
    local oldItem itemCol item

    oldItem=$(sed -n "${index}p" "$todoLocation")
    [[ -z "$oldItem" ]] && error "invalid todo index: $index"

    itemCol=$(extractColorFromItem "$oldItem")
    item="\\${itemCol}${newItem}"
    sed -i "${index}c\\${item}" "$todoLocation" # perform
}

strToColor() {
    case "$1" in
        red) echo "31";;
        green) echo "32";;
        yellow) echo "33";;
        blue) echo "34";;
        magenta|purple) echo "35";;
        cyan) echo "36";;
        *) error "invalid color: $1" ;;
    esac
}

extractColorFromItem() {
    if [[ "$1" =~ (\\033\[[^m]*m) ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
    fi
}


add=()
del=()

while (($#)); do
    case "$1" in
        -h|--help)
            usage;;
        -v|--version)
            ver;;
        -a|--add)
            shift
            while (($#)) && [[ $1 != -* ]]; do add+=("$1")
            shift; done;
            # echo "${add[@]}"
            # addTodoItem will be done after parsing because of --color
            continue;;
        -d|--delete)
            shift

            while (($#)) && [[ $1 != -* ]]; do
                if [[ $1 =~ ^([1-9][0-9]*)-([1-9][0-9]*)$ ]]; then
                    num1="${BASH_REMATCH[1]}"
                    num2="${BASH_REMATCH[2]}"

                    if (( num1 > num2 )); then
                        biggerNum="$num1"
                        smallerNum="$num2"
                    else
                        biggerNum="$num2"
                        smallerNum="$num1"
                    fi

                    for ((i=smallerNum; i<=biggerNum; i++)); do
                        del+=("$i")
                    done
                elif [[ $1 =~ ^[1-9][0-9]*$ ]]; then
                    del+=("$1")
                else
                    error "invalid delete argument: $1"
                fi

                shift
            done

            delTodoItemIndex
            continue;;
        -e|--edit)

            shift
            index="$1"
            shift
            edititem="$1"

            editTodoItem "$index" "$edititem"
            ;;
        -r|--reset)
            newTodo="/tmp/todo.txt"
            touch "$newTodo"
            if mv "$newTodo" "$todoLocation"; then
                echo "todo reset"
            fi
            ;;
        -c|--color)
            shift
            color="\033[0;$(strToColor "$1")m"
            ;;
        -*)
            error "unknown parameter $1";;
    esac
    shift
done

if (( ${#add[@]} > 0 )); then
    addTodoItem "${color:-}"
fi

listTodoItems
